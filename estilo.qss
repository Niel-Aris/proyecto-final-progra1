/* Diseño visual de La Pulpe.
   Colores: fondo gris claro, tarjetas blancas y azul para la acción principal.
   Los nombres con # son los objectName de los archivos .ui. */

QWidget {
    color: #1d1d1f;
    font-size: 13px;
}

QMainWindow, QWidget#centralWidget, QWidget#ProductosForm, QWidget#VentasForm, QWidget#HistorialForm {
    background: #f5f5f7;
}

/* Encabezado que agrega Estilo::aplicar */
QLabel#lblMarca {
    font-size: 26px;
    font-weight: 700;
}
QLabel#lblLema {
    color: #6e6e73;
    font-size: 13px;
}

/* Pestañas como control segmentado */
QTabWidget::pane {
    border: none;
    background: transparent;
    top: 4px;
}
QTabWidget::tab-bar {
    alignment: center;
}
QTabBar {
    background: #e3e3e8;
    border-radius: 9px;
}
QTabBar::tab {
    background: transparent;
    color: #1d1d1f;
    padding: 6px 22px;
    margin: 2px;
    border-radius: 7px;
    min-width: 70px;
    font-weight: 500;
}
QTabBar::tab:selected {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    background: #d8d8de;
}

/* Tablas como tarjetas blancas */
QTableWidget {
    outline: none;
    background: #ffffff;
    alternate-background-color: #fafafc;
    border: 1px solid #e0e0e5;
    border-radius: 12px;
    gridline-color: transparent;
    selection-background-color: #dcebfd;
    selection-color: #1d1d1f;
    padding: 4px;
}
QTableWidget::item {
    padding: 6px 8px;
    border: none;
}
QHeaderView {
    background: transparent;
}
QHeaderView::section {
    background: #ffffff;
    color: #6e6e73;
    font-size: 12px;
    font-weight: 600;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #ececf0;
}
QTableCornerButton::section {
    background: #ffffff;
    border: none;
}

/* Campos */
QLineEdit, QComboBox {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #0071e3;
    selection-color: #ffffff;
}
QSpinBox {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #0071e3;
    selection-color: #ffffff;
}
/* El campo de texto que va por dentro del número no lleva su propio borde */
QSpinBox QLineEdit {
    border: none;
    padding: 0px;
    margin: 0px;
    background: transparent;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #0071e3;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: none;
}
QComboBox::down-arrow {
    image: url(:/flecha.png);
    width: 12px;
    height: 12px;
}
QSpinBox::up-button, QSpinBox::down-button {
    width: 0px;
    border: none;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    padding: 4px;
    selection-background-color: #0071e3;
    selection-color: #ffffff;
    outline: none;
}

QLabel {
    background: transparent;
}

/* Botones */
QPushButton {
    background: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    border-radius: 9px;
    padding: 7px 18px;
    font-weight: 500;
}
QPushButton:hover {
    background: #f2f2f5;
}
QPushButton:pressed {
    background: #e6e6eb;
}

/* Acción principal de cada pantalla */
QPushButton#btnAgregar, QPushButton#btnCobrar, QPushButton#btnGenerar, QPushButton#btnGuardar, QPushButton#btnCrear {
    background: #0071e3;
    color: #ffffff;
    border: 1px solid #0071e3;
    font-weight: 600;
}
QPushButton#btnAgregar:hover, QPushButton#btnCobrar:hover, QPushButton#btnGenerar:hover, QPushButton#btnGuardar:hover, QPushButton#btnCrear:hover {
    background: #0077ed;
    border-color: #0077ed;
}
QPushButton#btnAgregar:pressed, QPushButton#btnCobrar:pressed, QPushButton#btnGenerar:pressed, QPushButton#btnGuardar:pressed, QPushButton#btnCrear:pressed {
    background: #0062c4;
    border-color: #0062c4;
}
QPushButton#btnCobrar {
    padding: 9px 28px;
    font-size: 14px;
}
QPushButton#btnCancelar {
    color: #e0352b;
}

/* Ventas: el total grande */
QLabel#lblTotal {
    font-size: 24px;
    font-weight: 700;
    padding-right: 12px;
}
QLabel#lblPago, QLabel#lblProducto, QLabel#lblCantidad, QLabel#lblFormato,
QLabel#lblCodigo, QLabel#lblNombre, QLabel#lblPrecio, QLabel#lblExistencias {
    color: #6e6e73;
}

/* Historial: el ticket como un recibo */
QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #e0e0e5;
    border-radius: 12px;
    padding: 12px;
}

/* Barras de desplazamiento delgadas */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px 4px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #c7c7cc;
    border-radius: 3px;
    min-height: 30px;
    min-width: 30px;
}
QScrollBar::handle:hover {
    background: #aeaeb2;
}
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0px;
    height: 0px;
}

/* Mensajes */
QMessageBox {
    background: #ffffff;
}
QMessageBox QPushButton {
    min-width: 80px;
}

/* Productos: búsqueda, filtros y ficha */
QLineEdit#txtBuscar {
    border-radius: 10px;
    padding: 7px 12px;
}
QPushButton#btnTodos, QPushButton#btnActivos, QPushButton#btnPocas, QPushButton#btnInactivos {
    background: transparent;
    color: #424245;
    border: 1px solid transparent;
    border-radius: 14px;
    padding: 5px 12px;
    font-weight: 500;
}
QPushButton#btnTodos:hover, QPushButton#btnActivos:hover, QPushButton#btnPocas:hover, QPushButton#btnInactivos:hover {
    background: #e8e8ed;
}
QPushButton#btnTodos:checked, QPushButton#btnActivos:checked, QPushButton#btnPocas:checked, QPushButton#btnInactivos:checked {
    background: #1d1d1f;
    color: #ffffff;
}
QLabel#lblTituloFicha {
    font-size: 20px;
    font-weight: 700;
}
QLabel#lblSubtitulo, QLabel#lblResumen {
    color: #6e6e73;
    font-size: 12px;
}
QLabel#lblRecibir {
    font-weight: 600;
    padding-top: 6px;
}
QPushButton#btnNuevo {
    background: transparent;
    color: #0071e3;
    border: none;
    padding: 4px 6px;
    font-weight: 600;
}
QPushButton#btnNuevo:hover {
    color: #0062c4;
}
QLineEdit:read-only {
    background: #f2f2f5;
    color: #6e6e73;
}

/* Ficha de productos tipo inspector */
QLineEdit#txtNombre {
    font-size: 20px;
    font-weight: 700;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 4px 6px;
}
QLineEdit#txtNombre:hover {
    background: #ffffff;
    border: 1px solid #d2d2d7;
}
QLineEdit#txtNombre:focus {
    background: #ffffff;
    border: 1px solid #0071e3;
}
QFrame#frmPrecio, QFrame#frmExistencias {
    background: #ffffff;
    border: 1px solid #e0e0e5;
    border-radius: 12px;
}
QLabel#lblPrecioTitulo, QLabel#lblExistenciasTitulo {
    color: #6e6e73;
    font-size: 12px;
    font-weight: 600;
}
QSpinBox#spnPrecio, QSpinBox#spnExistencias {
    font-size: 22px;
    font-weight: 700;
    background: transparent;
    border: 1px solid transparent;
    padding: 2px 4px;
}
QSpinBox#spnPrecio:hover, QSpinBox#spnExistencias:hover {
    border: 1px solid #e0e0e5;
}
QSpinBox#spnPrecio:focus, QSpinBox#spnExistencias:focus {
    border: 1px solid #0071e3;
}
QPushButton#btnMenos, QPushButton#btnMas {
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0px;
    border-radius: 16px;
    font-size: 18px;
    font-weight: 600;
    background: #f2f2f5;
    border: none;
}
QPushButton#btnMenos:hover, QPushButton#btnMas:hover {
    background: #e6e6eb;
}
QPushButton#btnMas6, QPushButton#btnMas12, QPushButton#btnMas24 {
    background: #e8f1fd;
    color: #0071e3;
    border: none;
    border-radius: 13px;
    padding: 5px 12px;
    font-weight: 600;
}
QPushButton#btnMas6:hover, QPushButton#btnMas12:hover, QPushButton#btnMas24:hover {
    background: #d6e7fc;
}
QLabel#lblRecibir, QLabel#lblActivo {
    font-weight: 500;
    padding-top: 0px;
}
QLabel#lblError {
    color: #d70015;
}
QLineEdit[error="true"], QSpinBox[error="true"] {
    border: 1px solid #d70015;
    background: #fff5f5;
}
QLabel#lblActividad {
    font-weight: 600;
    padding-top: 4px;
}
QListWidget#lstActividad {
    background: transparent;
    border: none;
    font-size: 12px;
    outline: none;
}
QListWidget#lstActividad::item {
    padding: 6px 2px;
    border-bottom: 1px solid #e8e8ed;
    color: #3a3a3c;
}
QFrame#barraDeshacer {
    background: #1d1d1f;
    border-radius: 10px;
}
QFrame#barraDeshacer QLabel {
    color: #ffffff;
}
QPushButton#btnDeshacer {
    background: transparent;
    border: none;
    color: #64d2ff;
    font-weight: 700;
    padding: 4px 6px;
}
QPushButton#btnDeshacer:hover {
    color: #9be3ff;
}

/* Vender: catálogo de tarjetas y carrito */
QLabel#lblAyuda {
    color: #6e6e73;
    font-size: 12px;
}
QListWidget#lstProductos {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget#lstProductos::item {
    background: #ffffff;
    border: 1px solid #e0e0e5;
    border-radius: 14px;
    padding: 8px 4px;
    margin: 4px;
    color: #1d1d1f;
}
QListWidget#lstProductos::item:hover {
    border: 1px solid #0071e3;
}
QListWidget#lstProductos::item:disabled {
    color: #a1a1a6;
    background: #fafafc;
}
QFrame#frmCarrito {
    background: #ffffff;
    border: 1px solid #e0e0e5;
    border-radius: 16px;
}
QLabel#lblVentaTitulo {
    font-size: 17px;
    font-weight: 700;
}
QLabel#lblArticulos {
    color: #6e6e73;
}
QPushButton#btnCancelar {
    background: transparent;
    border: none;
    color: #e0352b;
    font-weight: 600;
    padding: 4px 6px;
}
QPushButton#btnCancelar:hover {
    color: #b8261e;
}
QListWidget#lstCarrito {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget#lstCarrito::item {
    background: transparent;
    border: none;
    border-bottom: 1px solid #f0f0f3;
}
QLabel#filaNombre {
    font-weight: 600;
}
QLabel#filaPrecio {
    color: #6e6e73;
    font-size: 12px;
}
QLabel#filaCantidad {
    font-weight: 700;
}
QLabel#filaSubtotal {
    font-weight: 600;
}
QPushButton#filaMenos, QPushButton#filaMas {
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
    padding: 0px;
    border: none;
    border-radius: 13px;
    background: #f2f2f5;
    font-size: 16px;
    font-weight: 700;
}
QPushButton#filaMenos:hover, QPushButton#filaMas:hover {
    background: #e6e6eb;
}
QPushButton#filaQuitar {
    background: transparent;
    border: none;
    color: #aeaeb2;
    font-size: 18px;
    padding: 0px 4px;
}
QPushButton#filaQuitar:hover {
    color: #e0352b;
}
QLabel#lblVacio {
    color: #8e8e93;
    padding: 40px 0px;
}
QFrame#lineaTotal {
    border: none;
    background: #ececf0;
    min-height: 1px;
    max-height: 1px;
}
QLabel#lblTotalTitulo {
    color: #6e6e73;
    font-size: 15px;
    font-weight: 600;
}
QLabel#lblTotal {
    font-size: 30px;
    font-weight: 800;
    padding-right: 0px;
}
QSpinBox#spnPago {
    font-size: 17px;
    font-weight: 600;
}
QPushButton#btnRapido1, QPushButton#btnRapido2, QPushButton#btnRapido3, QPushButton#btnRapido4 {
    background: #f2f2f5;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 7px 4px;
    font-weight: 600;
}
QPushButton#btnRapido1:hover, QPushButton#btnRapido2:hover, QPushButton#btnRapido3:hover, QPushButton#btnRapido4:hover {
    background: #e6e6eb;
}
QPushButton[elegido="true"] {
    background: #e8f1fd;
    border: 1px solid #0071e3;
    color: #0071e3;
}
QLabel#lblVuelto[estado="nada"] {
    color: #8e8e93;
}
QLabel#lblVuelto[estado="falta"] {
    color: #d70015;
    font-weight: 600;
}
QLabel#lblVuelto[estado="vuelto"] {
    color: #1a7f37;
    font-size: 17px;
    font-weight: 700;
}
QPushButton#btnCobrar {
    padding: 12px;
    font-size: 16px;
}
QPushButton#btnCobrar:disabled {
    background: #b9d5f6;
    border: 1px solid #b9d5f6;
    color: #ffffff;
}
QFrame#frmExito {
    background: #ffffff;
    border-radius: 16px;
}
QLabel#lblExitoTitulo {
    font-size: 20px;
    font-weight: 700;
}
QLabel#lblExitoVuelto {
    font-size: 30px;
    font-weight: 800;
    color: #1a7f37;
}
QLabel#lblExitoDetalle {
    color: #6e6e73;
}
QPushButton#btnNuevaVenta {
    background: #0071e3;
    color: #ffffff;
    border: 1px solid #0071e3;
    padding: 10px;
    font-weight: 600;
}
